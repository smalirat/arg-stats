---
interface Column {
  key: string;
  label: string;
  align?: "left" | "center" | "right";
  highlight?: boolean;
}

interface Props {
  columns: Column[];
  rows: Record<string, any>[];
  hrefKey?: string;
  hrefPrefix?: string;
}

const { columns, rows, hrefKey, hrefPrefix = "" } = Astro.props;

const alignClass = (a?: string) =>
  a === "center" ? "text-center" : a === "right" ? "text-right" : "text-left";
---

<div class="table-scroll overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
  <table class="w-full text-sm">
    <thead>
      <tr class="sticky top-0 z-10 bg-slate-800 text-slate-100">
        {
          columns.map((col) => (
            <th
              class={`px-3 py-2.5 font-semibold whitespace-nowrap ${alignClass(col.align)}`}
            >
              {col.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, i) => {
          const href = hrefKey && row[hrefKey] ? `${hrefPrefix}${row[hrefKey]}` : null;
          return (
            <tr
              class={`border-t border-slate-100 transition-colors hover:bg-accent-50/60 ${
                i % 2 === 1 ? "bg-slate-50/60" : "bg-white"
              }`}
            >
              {columns.map((col) => (
                <td
                  class={`px-3 py-2.5 whitespace-nowrap ${alignClass(col.align)} ${
                    col.highlight ? "font-semibold text-slate-900" : "text-slate-600"
                  }`}
                >
                  {href && col.key === hrefKey ? (
                    <a href={href} class="text-accent-700 hover:text-accent-800 hover:underline font-medium">
                      {row[col.key]}
                    </a>
                  ) : (
                    row[col.key]
                  )}
                </td>
              ))}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
