---
interface Team {
  equipo_id: number;
  nombre_fuente: string;
  nombre_corto: string;
}

interface Props {
  teams: Team[];
}

const { teams } = Astro.props;
---

<div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
  {
    teams.map((t) => {
      // Preparamos el nombre seguro para evitar que crashee si viene null
      const nombreMostrar = t.nombre_corto || t.nombre_fuente || 'EQP';
      
      return (
        <a
          href={`/equipo/${t.equipo_id}`}
          class="group flex flex-col items-center gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-all hover:shadow-md hover:border-accent-300"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-lg font-bold text-slate-400 group-hover:bg-accent-50 group-hover:text-accent-600 transition-colors">
            {nombreMostrar.slice(0, 3).toUpperCase()}
          </div>
          <span class="text-sm font-medium text-slate-700 text-center group-hover:text-accent-700">
            {nombreMostrar}
          </span>
        </a>
      );
    })
  }
</div>
