---
interface Match {
  partido_id: number;
  fecha: string;
  torneo: string;
  local: string;
  visitante: string;
  goles_local: number | null;
  goles_visitante: number | null;
  estado: string;
}

interface Props {
  matches: Match[];
}

const { matches } = Astro.props;

const fmtFecha = (f: string) => {
  const d = new Date(f);
  return d.toLocaleDateString("es-AR", { day: "2-digit", month: "short" });
};
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    matches.map((m) => (
      <a
        href={`/partido/${m.partido_id}`}
        class="group block rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-all hover:shadow-md hover:border-accent-300"
      >
        <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
          <span>{fmtFecha(m.fecha)}</span>
          <span class="rounded bg-slate-100 px-2 py-0.5 font-medium text-slate-500">
            {m.torneo}
          </span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="text-sm font-medium text-slate-700 text-right flex-1 truncate">
            {m.local}
          </span>
          <span class="text-base font-bold text-slate-900 tabular-nums">
            {m.goles_local !== null ? `${m.goles_local}` : "-"}
            <span class="text-slate-300 mx-0.5">:</span>
            {m.goles_visitante !== null ? `${m.goles_visitante}` : "-"}
          </span>
          <span class="text-sm font-medium text-slate-700 text-left flex-1 truncate">
            {m.visitante}
          </span>
        </div>
        <div class="mt-2 text-center">
          <span class={`text-xs font-medium ${m.estado === "Finalizado" ? "text-accent-600" : "text-steel-500"}`}>
            {m.estado}
          </span>
        </div>
      </a>
    ))
  }
</div>
