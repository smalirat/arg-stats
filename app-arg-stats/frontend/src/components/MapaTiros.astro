---
// Mapa de tiros de un jugador en media cancha (el arco arriba), con filtro
// por temporada. Coordenadas de FotMob: cancha de 105 x 68, ataca hacia x = 105.
import { t } from "../lib/traducciones";

interface Props {
  tiros: any[];
}

const { tiros } = Astro.props;

const temporadas = [...new Set(tiros.map((s) => s.temporada))].sort().reverse();

// Media cancha vertical: el ancho es el eje y de FotMob y la altura la distancia al arco
const enCancha = tiros.map((s) => ({
  ...s,
  cx: s.y,
  cy: Math.min(Math.max(105 - s.x, 0), 52.5),
  r: 0.6 + (s.xg ?? 0) * 3,
}));

const resumen = (lista: any[]) => ({
  tiros: lista.length,
  goles: lista.filter((s) => s.resultado === "Goal").length,
  alArco: lista.filter((s) => s.resultado === "Goal" || s.resultado === "AttemptSaved").length,
  xg: lista.reduce((a, s) => a + (s.xg ?? 0), 0).toFixed(2),
});
const resumenes = [
  { temporada: "", ...resumen(tiros) },
  ...temporadas.map((tp) => ({ temporada: tp, ...resumen(tiros.filter((s) => s.temporada === tp)) })),
];

const estilo = (s: any) =>
  s.resultado === "Goal"
    ? { fill: "#0f5231", stroke: "#0f5231", opacidad: 0.9 }
    : s.resultado === "AttemptSaved"
      ? { fill: "white", stroke: "#0f5231", opacidad: 0.7 }
      : { fill: "white", stroke: "#9aa5a0", opacidad: 0.6 };
---

<section class="border border-gray-300 bg-white" data-mapa-tiros>
  <h2 class="bg-[#0f5231] text-white font-bold px-3 py-1.5 flex items-center justify-between gap-2">
    <span>Mapa de tiros</span>
    {temporadas.length > 1 && (
      <select data-filtro class="text-xs text-gray-800 font-normal border border-gray-300 p-0.5">
        <option value="">Todas las temporadas</option>
        {temporadas.map((tp) => <option value={tp}>{tp}</option>)}
      </select>
    )}
  </h2>
  {tiros.length ? (
    <div class="p-3 grid grid-cols-1 sm:grid-cols-[1fr_180px] gap-4 items-start">
      <svg viewBox="-1 -3 70 56.5" class="w-full max-w-[520px] mx-auto bg-[#f4f7f4] rounded-sm" role="img" aria-label="Mapa de tiros del jugador">
        <g fill="none" stroke="#9ab3a3" stroke-width="0.3">
          <rect x="0" y="0" width="68" height="52.5" />
          <rect x="13.84" y="0" width="40.32" height="16.5" />
          <rect x="24.84" y="0" width="18.32" height="5.5" />
          <rect x="30.34" y="-1.5" width="7.32" height="1.5" />
          <path d="M 26.69 16.5 A 9.15 9.15 0 0 0 41.31 16.5" />
          <path d="M 24.85 52.5 A 9.15 9.15 0 0 1 43.15 52.5" />
          <circle cx="34" cy="11" r="0.3" fill="#9ab3a3" />
        </g>
        {enCancha.map((s) => {
          const e = estilo(s);
          return (
            <circle data-temporada={s.temporada} cx={s.cx} cy={s.cy} r={s.r} fill={e.fill} fill-opacity={e.opacidad} stroke={e.stroke} stroke-width="0.3">
              <title>{`${s.temporada} · ${s.minuto}' vs ${s.rival?.nombre ?? "?"} · ${t(s.resultado)} · ${t(s.tipo)} · xG ${(s.xg ?? 0).toFixed(2)}`}</title>
            </circle>
          );
        })}
      </svg>
      <div>
        {resumenes.map((r) => (
          <dl data-resumen={r.temporada} hidden={r.temporada !== ""} class="grid grid-cols-2 gap-2 text-center">
            {[["Tiros", r.tiros], ["Goles", r.goles], ["A puerta", r.alArco], ["xG", r.xg]].map(([etiqueta, valor]) => (
              <div class="border border-gray-300 py-1.5">
                <dd class="text-lg font-bold tabular-nums">{valor}</dd>
                <dt class="text-[11px] text-gray-500">{etiqueta}</dt>
              </div>
            ))}
          </dl>
        ))}
        <ul class="mt-3 space-y-1 text-xs text-gray-600">
          <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#0f5231]"></span> Gol</li>
          <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full border-2 border-[#0f5231]"></span> Atajado</li>
          <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full border-2 border-[#9aa5a0]"></span> Afuera o bloqueado</li>
          <li class="text-gray-500">El tamaño es el xG del tiro.</li>
        </ul>
      </div>
    </div>
  ) : (
    <p class="px-3 py-4 text-gray-500">No hay tiros registrados para este jugador.</p>
  )}
</section>

<script>
  // Filtro por temporada: oculta los tiros de las otras y cambia el resumen
  for (const caja of document.querySelectorAll<HTMLElement>('[data-mapa-tiros]')) {
    const filtro = caja.querySelector<HTMLSelectElement>('[data-filtro]');
    filtro?.addEventListener('change', () => {
      const tp = filtro.value;
      caja.querySelectorAll<SVGElement>('circle[data-temporada]').forEach((c) => {
        c.style.display = !tp || c.dataset.temporada === tp ? '' : 'none';
      });
      caja.querySelectorAll<HTMLElement>('[data-resumen]').forEach((r) => (r.hidden = r.dataset.resumen !== tp));
    });
  }
</script>
