---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="mb-6">
  <div class="mb-3 flex items-end justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-900">{title}</h2>
      {
        subtitle && (
          <p class="mt-0.5 text-sm text-slate-500">{subtitle}</p>
        )
      }
    </div>
  </div>
  <slot />
</section>
