    class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2"
  >
    <p class="text-sm text-slate-500">
      &copy; {year} ArgStats — Datos históricos del fútbol argentino.
    </p>
    <p class="text-xs text-slate-400">
      Estadísticas avanzadas inspiradas en FBref.
    </p>
  </div>
</footer>
