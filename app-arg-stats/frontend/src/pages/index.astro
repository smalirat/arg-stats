---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { API_URL } from "../lib/api";

export const prerender = false;

const response = await fetch(`${API_URL}/api/home`);
const json = await response.json();

const homeData = json.data || {};

const ediciones = homeData.ediciones || [];
// [{ nombre, temporada, clubes: [...], partidos: [...] }]: las flechas de la
// ventana de clubes eligen la competición de Partidos Recientes y de Clubes
const competiciones = homeData.competiciones || [];

---

<BaseLayout title="ArgStats - Estadísticas de Fútbol Argentino">
  
  <!-- Inyectamos nuestro nuevo Header estilo FBref y le pasamos las ediciones -->
  <SiteHeader ediciones={ediciones} />

  <main class="max-w-[1200px] mx-auto px-2 sm:px-4 py-6 font-sans">
    
    <!-- Subtítulo estilo referencia -->
    <p class="text-sm text-gray-800 mb-6 border-b border-gray-300 pb-2">
      <strong>Estadísticas e Historia del Fútbol Argentino:</strong> Estadísticas, resultados y archivos históricos para competiciones, clubes y jugadores nacionales.
    </p>

    <!-- Disposición en 3 Columnas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">

      <!-- COLUMNA 1: Últimos Partidos -->
      <div class="border border-gray-300 bg-white">
        <div class="bg-[#0f5231] text-white font-bold px-3 py-1.5 text-sm">
          Partidos Recientes
        </div>
        {competiciones.map((competicion: any, i: number) => (
        <div class="p-3" data-competicion={i} hidden={i !== 0}>
          <div class="space-y-4">
            {competicion.partidos.map((p: any) => (
              <div class="text-sm border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                <div class="text-xs text-gray-500 mb-1 font-medium">
                  {p.fecha_utc ? new Date(p.fecha_utc).toLocaleDateString() : 'Sin fecha'} · {p.estado}
                </div>
                <div class="flex justify-between items-center mb-0.5">
                  <!-- CORRECCIÓN: Leemos la columna plana de la vista SQL -->
                  <span class="font-medium text-gray-800">{p.local_nombre_corto || p.local_nombre_fuente || 'Local'}</span>
                  <span class="font-bold bg-gray-100 px-2 py-0.5 rounded">{p.goles_local ?? '-'}</span>
                </div>
                <div class="flex justify-between items-center">
                  <!-- CORRECCIÓN: Leemos la columna plana de la vista SQL -->
                  <span class="font-medium text-gray-800">{p.visitante_nombre_corto || p.visitante_nombre_fuente || 'Visitante'}</span>
                  <span class="font-bold bg-gray-100 px-2 py-0.5 rounded">{p.goles_visitante ?? '-'}</span>
                </div>
                <a href={`/partido/${p.partido_id}`} class="text-[#2a6496] hover:bg-[#2a6496] hover:text-white text-xs mt-2 inline-block px-1 rounded transition-colors">
                  Ficha del partido &rarr;
                </a>
              </div>
            ))}
          </div>
        </div>
        ))}
      </div>

      <!-- COLUMNA 2: Clubes por competición (las flechas cambian de competición) -->
      <div class="border border-gray-300 bg-white" data-clubes>
        <div class="bg-[#0f5231] text-white font-bold px-1 py-1 text-sm flex items-center justify-between gap-2">
          <button type="button" data-anterior aria-label="Competición anterior" class="px-2 py-0.5 rounded-sm hover:bg-[#0a3a22] transition-colors">&#9664;</button>
          <span data-titulo class="truncate">
            {competiciones[0]?.nombre}
          </span>
          <button type="button" data-siguiente aria-label="Competición siguiente" class="px-2 py-0.5 rounded-sm hover:bg-[#0a3a22] transition-colors">&#9654;</button>
        </div>

        {competiciones.map((competicion: any, i: number) => (
          <div class="p-3" data-competicion={i} data-panel data-titulo-panel={competicion.nombre} hidden={i !== 0}>
            <div class="grid grid-cols-2 gap-x-2 gap-y-3 max-h-[420px] overflow-y-auto">
              {competicion.clubes.map((eq: any) => {
                // Calculamos un nombre seguro para evitar que el slice() rompa
                const nombreSeguro = eq.nombre_corto || eq.nombre_fuente || 'ARG';
                return (
                  <a href={`/equipo/${eq.equipo_id}`} class="flex items-center gap-2 group">
                    <div class="w-7 h-7 shrink-0 bg-gray-100 border border-gray-200 text-[#0f5231] text-[10px] font-bold flex items-center justify-center rounded group-hover:bg-[#0f5231] group-hover:text-white transition-colors">
                      {nombreSeguro.slice(0, 3).toUpperCase()}
                    </div>
                    <span class="text-sm text-[#2a6496] group-hover:underline font-medium truncate">
                      {nombreSeguro}
                    </span>
                  </a>
                )
              })}
            </div>

            <div class="mt-5 border-t border-gray-200 pt-3">
               <label class="block text-xs font-bold text-gray-700 mb-1">Buscar club directo:</label>
               <select class="w-full text-sm border border-gray-300 p-1.5 focus:outline-none focus:border-[#0f5231]">
                 <option value="">Seleccionar club...</option>
                 {competicion.clubes.map((eq: any) => (
                   <option value={eq.equipo_id}>{eq.nombre_fuente}</option>
                 ))}
               </select>
               <button type="button" data-ir class="mt-2 bg-[#0f5231] text-white text-sm font-bold px-3 py-1 rounded-sm w-full hover:bg-[#0a3a22]">Ir</button>
            </div>
          </div>
        ))}
      </div>

      <!-- COLUMNA 3: Archivo Histórico (Ediciones DB) -->
      <div class="border border-gray-300 bg-white">
        <div class="bg-[#0f5231] text-white font-bold px-3 py-1.5 text-sm">
          Archivo Histórico ArgStats
        </div>
        
        <!-- Bloque estilo Banner/Anuncio pero funcional -->
        <div class="bg-gray-100 border-b border-gray-300 p-4 text-center">
          <h3 class="font-bold text-gray-800 text-sm mb-1">La base de datos definitiva</h3>
          <p class="text-xs text-gray-600 mb-3">Explorá el historial de competiciones, posiciones y resultados minuto a minuto.</p>
          <a href="#" class="bg-[#0f5231] text-white text-xs font-bold px-4 py-2 rounded-sm hover:bg-[#0a3a22] inline-block">
            Explorar torneos
          </a>
        </div>

        <div class="p-3">
          <h4 class="font-bold text-gray-800 text-sm mb-2 border-b border-gray-200 pb-1">Ediciones Registradas</h4>
          <ul class="space-y-1.5 text-sm mb-4">
            {ediciones.map((ed: any) => (
              <li class="flex justify-between items-center">
                <a href={`/torneo/${ed.edicion_id}`} class="text-[#2a6496] hover:bg-[#2a6496] hover:text-white px-1 rounded transition-colors font-medium">
                  {ed.nombre_torneo}
                </a>
                <span class="text-gray-500 text-xs font-mono">{ed.temporada}</span>
              </li>
            ))}
          </ul>

          <div class="bg-[#f0edf7] border border-[#d3cce3] p-3 rounded-sm text-xs text-gray-800 mt-4">
            <strong class="block mb-1 text-[#4a3b72]">Métricas disponibles:</strong>
            <ul class="list-disc pl-4 space-y-1">
              <li>Expected Goals (xG) y Asistencias (xA).</li>
              <li>Radiografía de momentum por partido.</li>
              <li>Historial de alineaciones y tarjetas.</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  // Las flechas de la ventana de clubes recorren las competiciones (vuelve al
  // principio después de la última) y cambian a la vez Partidos Recientes y
  // Clubes (todo bloque con data-competicion). "Ir" abre el club elegido.
  for (const caja of document.querySelectorAll<HTMLElement>('[data-clubes]')) {
    const paneles = [...caja.querySelectorAll<HTMLElement>('[data-panel]')];
    const bloques = [...document.querySelectorAll<HTMLElement>('[data-competicion]')];
    const titulo = caja.querySelector<HTMLElement>('[data-titulo]')!;
    let actual = 0;

    const mostrar = (indice: number) => {
      actual = (indice + paneles.length) % paneles.length;
      bloques.forEach(bloque => (bloque.hidden = bloque.dataset.competicion !== String(actual)));
      titulo.textContent = paneles[actual].dataset.tituloPanel ?? '';
    };

    caja.querySelector('[data-anterior]')?.addEventListener('click', () => mostrar(actual - 1));
    caja.querySelector('[data-siguiente]')?.addEventListener('click', () => mostrar(actual + 1));

    for (const panel of paneles) {
      const select = panel.querySelector('select')!;
      panel.querySelector('[data-ir]')?.addEventListener('click', () => {
        if (select.value) window.location.href = `/equipo/${select.value}`;
      });
    }
  }
</script>