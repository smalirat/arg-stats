---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";
import DataTable from "../../components/DataTable.astro";

export function getStaticPaths() {
  return [101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112].map((id) => ({ params: { id: String(id) } }));
}

const { id } = Astro.params;

// ── MOCK DATA ──────────────────────────────────────────────
const jugador = {
  jugador_id: 105,
  nombre_completo: "Miguel Ángel Borja",
  nombre_corto: "Miguel Borja",
  fecha_nacimiento: "1993-01-26",
  edad: 32,
  nacionalidad: "Colombia",
  posicion: "Delantero",
  altura_cm: 185,
  pie_habil: "Derecho",
  equipo_actual: "River Plate",
  equipo_id: 1,
};

const statsAgregadas = [
  { label: "Partidos jugados", valor: 12 },
  { label: "Titularidades", valor: 10 },
  { label: "Minutos", valor: 847 },
  { label: "Goles", valor: 9 },
  { label: "Asistencias", valor: 4 },
  { label: "xG", valor: "7.8" },
  { label: "xA", valor: "3.2" },
  { label: "Rating promedio", valor: "7.4" },
];

const transferencias = [
  { transferencia_id: 1, fecha: "2025-01-15", de: "Palmeiras", a: "River Plate", tipo: "Compra", valor: "5.0M" },
  { transferencia_id: 2, fecha: "2022-07-01", de: "Junior FC", a: "Palmeiras", tipo: "Compra", valor: "3.5M" },
  { transferencia_id: 3, fecha: "2021-01-10", de: "Atlético Nacional", a: "Junior FC", tipo: "Compra", valor: "2.0M" },
  { transferencia_id: 4, fecha: "2019-06-20", de: "Oriente Petrolero", a: "Atlético Nacional", tipo: "Préstamo", valor: "-" },
];

const statsPorPartido = [
  { partido_id: 101, rival: "Boca Juniors", minutos: 90, goles: 1, asistencias: 0, xg: "1.2", xa: "0.3", rating: "7.8" },
  { partido_id: 107, rival: "Vélez", minutos: 75, goles: 2, asistencias: 1, xg: "1.5", xa: "0.5", rating: "8.5" },
  { partido_id: 113, rival: "Talleres", minutos: 90, goles: 1, asistencias: 0, xg: "0.9", xa: "0.1", rating: "7.2" },
  { partido_id: 119, rival: "Belgrano", minutos: 60, goles: 0, asistencias: 1, xg: "0.4", xa: "0.6", rating: "6.9" },
  { partido_id: 125, rival: "Gimnasia", minutos: 90, goles: 3, asistencias: 0, xg: "2.1", xa: "0.2", rating: "9.1" },
  { partido_id: 131, rival: "Racing", minutos: 0, goles: 0, asistencias: 0, xg: "-", xa: "-", rating: "-" },
];

const transferenciaColumns = [
  { key: "fecha", label: "Fecha", align: "left" as const },
  { key: "de", label: "Desde", align: "left" as const },
  { key: "a", label: "Hacia", align: "left" as const },
  { key: "tipo", label: "Tipo", align: "center" as const },
  { key: "valor", label: "Valor", align: "right" as const },
];

const statsColumns = [
  { key: "partido_id", label: "Partido", align: "center" as const },
  { key: "rival", label: "Rival", align: "left" as const, highlight: true },
  { key: "minutos", label: "Min", align: "center" as const },
  { key: "goles", label: "G", align: "center" as const },
  { key: "asistencias", label: "A", align: "center" as const },
  { key: "xg", label: "xG", align: "center" as const },
  { key: "xa", label: "xA", align: "center" as const },
  { key: "rating", label: "Rating", align: "center" as const },
];
// ────────────────────────────────────────────────────────────
---

<BaseLayout title={`${jugador.nombre_corto} — ArgStats`}>
  <div class="mb-6">
    <a href="/equipo/1" class="text-sm text-slate-500 hover:text-accent-700">&larr; {jugador.equipo_actual}</a>
  </div>

  <!-- Header del jugador -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-steel-50 text-xl font-bold text-steel-700">
      {jugador.nombre_corto.split(" ").map((p) => p[0]).join("").slice(0, 2).toUpperCase()}
    </div>
    <div class="flex-1">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">{jugador.nombre_completo}</h1>
      <p class="mt-1 text-sm text-slate-500">
        {jugador.posicion} · {jugador.nacionalidad} · {jugador.edad} años · {jugador.altura_cm} cm · Pie {jugador.pie_habil.toLowerCase()}
      </p>
    </div>
  </div>

  <!-- Stats agregadas -->
  <SectionCard title="Estadísticas de temporada" subtitle="Métricas avanzadas agregadas">
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
      {statsAgregadas.map((s) => (
        <div class="rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm">
          <div class="text-2xl font-bold text-slate-900 tabular-nums">{s.valor}</div>
          <div class="mt-0.5 text-xs text-slate-500">{s.label}</div>
        </div>
      ))}
    </div>
  </SectionCard>

  <SectionCard title="Historial de transferencias" subtitle="Movimientos del jugador entre clubes">
    <DataTable columns={transferenciaColumns} rows={transferencias} />
  </SectionCard>

  <SectionCard title="Estadísticas por partido" subtitle="Métricas detalladas por encuentro (xG, xA, minutos, rating)">
    <DataTable columns={statsColumns} rows={statsPorPartido} hrefKey="partido_id" hrefPrefix="/partido/" />
  </SectionCard>
</BaseLayout>
