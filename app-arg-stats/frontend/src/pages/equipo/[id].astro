---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";
import DataTable from "../../components/DataTable.astro";
import MatchCard from "../../components/MatchCard.astro";

const { id } = Astro.params;

// 1. Buscamos los datos en tu backend
const response = await fetch(`http://localhost:3000/api/equipos/${id}`);
const data = await response.json();

const equipo = data.perfil || {};
const plantel = data.plantel || [];
const posicionesRaw = data.resumen || {}; 
const ultimosPartidos = data.ultimosPartidos || []; 

const nombreMostrar = equipo.nombre_corto || equipo.nombre_fuente || "EQP";

const resumen = [
  { label: "Partidos jugados", valor: posicionesRaw.partidos_jugados ?? "-" },
  { label: "Victorias", valor: posicionesRaw.victorias ?? "-" },
  { label: "Empates", valor: posicionesRaw.empates ?? "-" },
  { label: "Derrotas", valor: posicionesRaw.derrotas ?? "-" },
  { label: "Goles a favor", valor: posicionesRaw.goles_favor ?? "-" },
  { label: "Goles en contra", valor: posicionesRaw.goles_contra ?? "-" },
  { label: "Diferencia de gol", valor: posicionesRaw.diferencia_gol ?? "-" },
  { label: "Puntos", valor: posicionesRaw.puntos ?? "-" },
];

const plantelColumns = [
  { key: "camiseta", label: "#", align: "center" as const },
  { key: "nombre", label: "Jugador", align: "left" as const, highlight: true },
  { key: "posicion", label: "Pos", align: "center" as const }
];
---

<BaseLayout title={`${nombreMostrar} — ArgStats`}>
  <div class="mb-6">
    <a href="/" class="text-sm text-slate-500 hover:text-accent-700">&larr; Inicio</a>
  </div>

  <div class="mb-8 flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-50 text-xl font-bold text-accent-700">
      <!-- Usamos la variable segura -->
      {nombreMostrar.slice(0, 3).toUpperCase()}
    </div>
    <div class="flex-1">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">{equipo.nombre_fuente}</h1>
      <p class="mt-1 text-sm text-slate-500">
        <!-- Ocultamos datos que no existen en tu esquema actual -->
        Datos históricos extraídos · ArgStats
      </p>
    </div>
  </div>

  <SectionCard title="Resumen de temporada" subtitle="Estadísticas de la tabla de posiciones">
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
      {resumen.map((r) => (
        <div class="rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm">
          <div class="text-2xl font-bold text-slate-900 tabular-nums">{r.valor}</div>
          <div class="mt-0.5 text-xs text-slate-500">{r.label}</div>
        </div>
      ))}
    </div>
  </SectionCard>

  <SectionCard title="Plantel actual" subtitle="Jugadores asociados al club">
    <DataTable columns={plantelColumns} rows={plantel} hrefKey="nombre" hrefPrefix="/jugador/" />
  </SectionCard>

  <SectionCard title="Últimos partidos" subtitle="Historial reciente del equipo">
    <MatchCard matches={ultimosPartidos} />
  </SectionCard>
</BaseLayout>