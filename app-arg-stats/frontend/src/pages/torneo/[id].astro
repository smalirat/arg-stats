---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";
import PositionTable from "../../components/PositionTable.astro";
import MatchCard from "../../components/MatchCard.astro";

export function getStaticPaths() {
  return [1, 2, 3, 4, 5, 6].map((id) => ({ params: { id: String(id) } }));
}

const { id } = Astro.params;

// ── MOCK DATA ──────────────────────────────────────────────
