---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";
import PositionTable from "../../components/PositionTable.astro";
import MatchCard from "../../components/MatchCard.astro";
import { API_URL } from "../../lib/api";

const { id } = Astro.params;

const response = await fetch(`${API_URL}/api/ediciones/${id}`);
// La API responde { status, data }
const { data = {} } = await response.json();

const edicion = data.edicion;
const posiciones = data.posiciones || [];
const partidos = data.partidos || [];
---

<!-- El nombre de la edición no lleva el año: va en temporada -->
<BaseLayout title={`${edicion.nombre_torneo} ${edicion.temporada} — ArgStats`}>
  <!-- Breadcrumb + título -->
  <div class="mb-6">
    <a href="/" class="text-sm text-slate-500 hover:text-accent-700">&larr; Inicio</a>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">{edicion.nombre_torneo} {edicion.temporada}</h1>
    </div>
    <p class="mt-1 text-sm text-slate-500">
      Argentina · Temporada {edicion.temporada}
    </p>
  </div>

  <SectionCard title="Tabla de posiciones" subtitle="Ordenado por puntos · Verde = zona de clasificación, Rojo = descenso">
    <PositionTable rows={posiciones} />
  </SectionCard>

  <SectionCard title="Partidos de la edición" subtitle="Resultados y próximos encuentros">
    <MatchCard matches={partidos} />
  </SectionCard>
</BaseLayout>
