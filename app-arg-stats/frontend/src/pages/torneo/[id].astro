  { posicion: 2, equipo_id: 7, nombre_corto: "Estudiantes", pj: 12, g: 7, e: 4, p: 1, gf: 19, gc: 7, dif: 12, pts: 25 },
  { posicion: 3, equipo_id: 2, nombre_corto: "Boca Juniors", pj: 12, g: 7, e: 3, p: 2, gf: 18, gc: 10, dif: 8, pts: 24 },
  { posicion: 4, equipo_id: 5, nombre_corto: "San Lorenzo", pj: 12, g: 6, e: 4, p: 2, gf: 16, gc: 9, dif: 7, pts: 22 },
  { posicion: 5, equipo_id: 3, nombre_corto: "Racing", pj: 12, g: 6, e: 3, p: 3, gf: 17, gc: 12, dif: 5, pts: 21 },
  { posicion: 6, equipo_id: 4, nombre_corto: "Independiente", pj: 12, g: 5, e: 5, p: 2, gf: 14, gc: 11, dif: 3, pts: 20 },
  { posicion: 7, equipo_id: 6, nombre_corto: "Huracán", pj: 12, g: 5, e: 4, p: 3, gf: 13, gc: 12, dif: 1, pts: 19 },
