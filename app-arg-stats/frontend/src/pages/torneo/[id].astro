  { posicion: 9, equipo_id: 9, nombre_corto: "Vélez", pj: 12, g: 4, e: 4, p: 4, gf: 12, gc: 13, dif: -1, pts: 16 },
  { posicion: 10, equipo_id: 10, nombre_corto: "Talleres", pj: 12, g: 3, e: 6, p: 3, gf: 10, gc: 11, dif: -1, pts: 15 },
  { posicion: 11, equipo_id: 11, nombre_corto: "Belgrano", pj: 12, g: 3, e: 4, p: 5, gf: 9, gc: 14, dif: -5, pts: 13 },
