const partidos = [
  { partido_id: 101, fecha: "2025-08-17", torneo: "Liga Profesional", local: "River Plate", visitante: "Boca Juniors", goles_local: 2, goles_visitante: 1, estado: "Finalizado" },
  { partido_id: 102, fecha: "2025-08-17", torneo: "Liga Profesional", local: "Racing", visitante: "Independiente", goles_local: 0, goles_visitante: 0, estado: "Finalizado" },
  { partido_id: 103, fecha: "2025-08-18", torneo: "Liga Profesional", local: "San Lorenzo", visitante: "Huracán", goles_local: 3, goles_visitante: 2, estado: "Finalizado" },
