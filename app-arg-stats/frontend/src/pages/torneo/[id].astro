// ────────────────────────────────────────────────────────────
---

<BaseLayout title={`${edicion.nombre_torneo} — ArgStats`}>
  <!-- Breadcrumb + título -->
  <div class="mb-6">
    <a href="/" class="text-sm text-slate-500 hover:text-accent-700">&larr; Inicio</a>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">{edicion.nombre_torneo}</h1>
      <span class={`rounded-full px-3 py-1 text-xs font-medium ${edicion.estado === "En curso" ? "bg-accent-50 text-accent-700" : "bg-slate-100 text-slate-500"}`}>
        {edicion.estado}
      </span>
    </div>
    <p class="mt-1 text-sm text-slate-500">
      {edicion.pais} · Temporada {edicion.temporada} · Fecha {edicion.fecha_actual} de {edicion.fecha_total}
    </p>
  </div>

  <SectionCard title="Tabla de posiciones" subtitle="Ordenado por puntos · Verde = zona de clasificación, Rojo = descenso">
    <PositionTable rows={posiciones} />
  </SectionCard>

  <SectionCard title="Partidos de la edición" subtitle="Resultados y próximos encuentros">
    <MatchCard matches={partidos} />
  </SectionCard>
</BaseLayout>
