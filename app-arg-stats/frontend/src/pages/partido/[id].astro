---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";

const { id } = Astro.params;

const response = await fetch(`http://localhost:3000/api/partidos/${id}`);
const data = await response.json();

const partido = data.partido;
const alineacionLocal = data.alineacionLocal;
const alineacionVisitante = data.alineacionVisitante;
const eventos = data.eventos || [];

---

<BaseLayout title={`${partido.local.nombre} ${partido.local.goles} - ${partido.visitante.goles} ${partido.visitante.nombre} — ArgStats`}>
  <div class="mb-6">
    <a href="/torneo/1" class="text-sm text-slate-500 hover:text-accent-700">&larr; {partido.torneo}</a>
  </div>

  <!-- Marcador -->
  <div class="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-center gap-2 text-sm text-slate-500">
      <span>{partido.fecha}</span>
      <span>·</span>
      <span>{partido.estadio}</span>
      <span>·</span>
      <span class={`font-medium ${partido.estado === "Finalizado" ? "text-accent-600" : "text-steel-500"}`}>{partido.estado}</span>
    </div>
    <div class="flex items-center justify-center gap-6 sm:gap-12">
      <a href={`/equipo/${partido.local.equipo_id}`} class="flex flex-col items-center gap-2 hover:opacity-80 transition">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-lg font-bold text-accent-700">
          {partido.local.nombre.slice(0, 3).toUpperCase()}
        </div>
        <span class="text-sm font-semibold text-slate-700">{partido.local.nombre}</span>
      </a>
      <div class="flex items-center gap-3 text-4xl sm:text-5xl font-bold text-slate-900 tabular-nums">
        <span>{partido.local.goles}</span>
        <span class="text-slate-300">:</span>
        <span>{partido.visitante.goles}</span>
      </div>
      <a href={`/equipo/${partido.visitante.equipo_id}`} class="flex flex-col items-center gap-2 hover:opacity-80 transition">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-steel-50 text-lg font-bold text-steel-700">
          {partido.visitante.nombre.slice(0, 3).toUpperCase()}
        </div>
        <span class="text-sm font-semibold text-slate-700">{partido.visitante.nombre}</span>
      </a>
    </div>
  </div>

  <!-- Alineaciones -->
  <SectionCard title="Alineaciones" subtitle="Titulares y suplentes de ambos equipos">
    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Local -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-900">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-500"></span>
          {partido.local.nombre} — Titulares
        </h3>
        <div class="space-y-1">
          {alineacionLocal.titulares.map((j) => (
            <a href={`/jugador/${j.jugador_id}`} class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-accent-50 transition-colors">
              <span class="flex h-6 w-6 items-center justify-center rounded bg-slate-100 text-xs font-bold text-slate-500">{j.camiseta}</span>
              <span class="flex-1 text-sm font-medium text-slate-700 hover:text-accent-700">{j.nombre}</span>
              <span class="text-xs text-slate-400">{j.posicion}</span>
            </a>
          ))}
        </div>
        <h4 class="mt-4 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Suplentes</h4>
        <div class="space-y-1">
          {alineacionLocal.suplentes.map((j) => (
            <a href={`/jugador/${j.jugador_id}`} class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-accent-50 transition-colors">
              <span class="flex h-6 w-6 items-center justify-center rounded bg-slate-100 text-xs font-bold text-slate-500">{j.camiseta}</span>
              <span class="flex-1 text-sm font-medium text-slate-700 hover:text-accent-700">{j.nombre}</span>
              <span class="text-xs text-slate-400">{j.posicion}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Visitante -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-900">
          <span class="h-2.5 w-2.5 rounded-full bg-steel-500"></span>
          {partido.visitante.nombre} — Titulares
        </h3>
        <div class="space-y-1">
          {alineacionVisitante.titulares.map((j) => (
            <a href={`/jugador/${j.jugador_id}`} class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-steel-50 transition-colors">
              <span class="flex h-6 w-6 items-center justify-center rounded bg-slate-100 text-xs font-bold text-slate-500">{j.camiseta}</span>
              <span class="flex-1 text-sm font-medium text-slate-700 hover:text-steel-700">{j.nombre}</span>
              <span class="text-xs text-slate-400">{j.posicion}</span>
            </a>
          ))}
        </div>
        <h4 class="mt-4 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Suplentes</h4>
        <div class="space-y-1">
          {alineacionVisitante.suplentes.map((j) => (
            <a href={`/jugador/${j.jugador_id}`} class="flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-steel-50 transition-colors">
              <span class="flex h-6 w-6 items-center justify-center rounded bg-slate-100 text-xs font-bold text-slate-500">{j.camiseta}</span>
              <span class="flex-1 text-sm font-medium text-slate-700 hover:text-steel-700">{j.nombre}</span>
              <span class="text-xs text-slate-400">{j.posicion}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </SectionCard>

  <!-- Línea de tiempo de eventos -->
  <SectionCard title="Línea de tiempo" subtitle="Eventos cronológicos del partido">
    <div class="relative rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="absolute left-[52%] top-4 bottom-4 w-px bg-slate-200"></div>
      <div class="space-y-3">
        {eventos.map((ev) => (
          <div class={`flex items-start gap-3 ${ev.equipo === "visitante" ? "flex-row-reverse" : ""}`}>
            <div class={`flex w-12 shrink-0 justify-end ${ev.equipo === "visitante" ? "justify-start" : ""}`}>
              <span class="text-xs font-bold text-slate-400 tabular-nums">{ev.minuto}'</span>
            </div>
            <div class={`relative flex-1 ${ev.equipo === "visitante" ? "text-right" : ""}`}>
              <div class={`inline-block rounded-lg px-3 py-2 ${ev.equipo === "local" ? "bg-accent-50" : "bg-steel-50"}`}>
                <div class="flex items-center gap-2">
                  <span class="text-sm">{tipoIcono[ev.tipo] ?? "•"}</span>
                  <span class="text-sm font-semibold text-slate-800">{ev.jugador}</span>
                  <span class="text-xs text-slate-500">{ev.tipo}</span>
                </div>
                <p class="mt-0.5 text-xs text-slate-500">{ev.detalle}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </SectionCard>

  <!-- Placeholders de momentum y tiros -->
  <div class="grid gap-4 lg:grid-cols-2">
    <SectionCard title="Gráfico de momentum" subtitle="Presión y control del partido minuto a minuto">
      <div class="flex h-48 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-center">
        <div>
          <span class="block text-2xl text-slate-300">📈</span>
          <p class="mt-2 text-sm text-slate-400">Placeholder — Aquí se renderizará el gráfico de momentum del partido.</p>
        </div>
      </div>
    </SectionCard>

    <SectionCard title="Mapa de tiros" subtitle="Ubicación y resultado de cada remate">
      <div class="flex h-48 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-center">
        <div>
          <span class="block text-2xl text-slate-300">🎯</span>
          <p class="mt-2 text-sm text-slate-400">Placeholder — Aquí se renderizará el mapa de tiros de cada equipo.</p>
        </div>
      </div>
    </SectionCard>
  </div>
</BaseLayout>
