---
// Partidos de un día: /partidos/fecha/{AAAA-MM-DD} (como "Scores & Fixtures" de FBref)
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Escudo from "../../../components/Escudo.astro";
import { API_URL } from "../../../lib/api";
import { urlEquipo, urlPartido, urlTorneo } from "../../../lib/urls";
import { hora, ronda as nombreRonda } from "../../../lib/formato";

const { dia } = Astro.params;
// AAAA-MM-DD y una fecha que existe (descarta 2026-13-99 o 2026-02-30)
const fechaValida = /^\d{4}-\d{2}-\d{2}$/.test(dia ?? "") && !Number.isNaN(Date.parse(`${dia}T00:00:00Z`))
  && new Date(`${dia}T00:00:00Z`).toISOString().slice(0, 10) === dia;
if (!fechaValida) return Astro.rewrite("/404");

const response = await fetch(`${API_URL}/api/partidos?fecha=${dia}`);
// La API responde { status, data }
const { data = {} } = await response.json();
const torneos = data.torneos || [];

// Fechas sin zona: se formatean como día calendario, sin corrimiento horario
const largo = (d: string) =>
  new Intl.DateTimeFormat("es-AR", { timeZone: "UTC", weekday: "long", day: "numeric", month: "long", year: "numeric" }).format(new Date(`${d}T12:00:00Z`));
const corto = (d: string) =>
  new Intl.DateTimeFormat("es-AR", { timeZone: "UTC", day: "numeric", month: "short", year: "numeric" }).format(new Date(`${d}T12:00:00Z`));

const urlDia = (d: string) => `/partidos/fecha/${d}`;
const titulo = `Partidos del ${largo(data.fecha)}`;
---

<BaseLayout title={`${titulo} — ArgStats`}>
  <div class="font-sans text-sm text-gray-800 space-y-4">

    <section class="border border-gray-300 bg-white px-4 py-3 space-y-3">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 first-letter:uppercase">{titulo}</h1>
        <p class="text-gray-600">
          {data.total ? `${data.total} partidos en ${torneos.length} ${torneos.length === 1 ? "torneo" : "torneos"}.` : "No hay partidos registrados este día."}
          Horarios en hora argentina.
        </p>
      </div>

      <!-- Navegación entre días con partidos -->
      <div class="flex flex-wrap items-center gap-2">
        {data.anterior
          ? <a href={urlDia(data.anterior)} class="px-3 py-1 border border-gray-300 text-[#2a6496] hover:bg-gray-50">&laquo; {corto(data.anterior)}</a>
          : <span class="px-3 py-1 border border-gray-200 text-gray-300">&laquo; Anterior</span>}
        {data.fecha !== data.hoy && <a href={urlDia(data.hoy)} class="px-3 py-1 border border-gray-300 text-[#2a6496] hover:bg-gray-50">Hoy</a>}
        {data.siguiente
          ? <a href={urlDia(data.siguiente)} class="px-3 py-1 border border-gray-300 text-[#2a6496] hover:bg-gray-50">{corto(data.siguiente)} &raquo;</a>
          : <span class="px-3 py-1 border border-gray-200 text-gray-300">Siguiente &raquo;</span>}
        <label class="ml-auto text-xs font-bold text-gray-700">
          Ir a la fecha
          <input type="date" data-fecha value={data.fecha} min={data.primera} max={data.ultima} class="ml-1 text-sm border border-gray-300 p-1 focus:outline-none focus:border-[#0f5231]" />
        </label>
      </div>
      <p class="text-xs text-gray-500">Hay partidos con fecha desde el {corto(data.primera)} hasta el {corto(data.ultima)}. Los históricos anteriores no tienen fecha en la base.</p>
    </section>

    {torneos.map((t: any) => (
      <section class="border border-gray-300 bg-white overflow-x-auto">
        <h2 class="bg-[#0f5231] text-white font-bold px-3 py-1.5 flex justify-between gap-2">
          <a href={urlTorneo(t.edicion)} class="hover:underline">{t.edicion.nombre_torneo} {t.edicion.temporada}</a>
          <span class="font-normal text-xs self-center">{t.competicion}</span>
        </h2>
        <table class="w-full text-xs sm:text-sm">
          <thead>
            <tr class="text-gray-600 border-b border-gray-300 bg-gray-50">
              <th class="px-2 py-1 text-left font-semibold w-14">Hora</th>
              <th class="px-2 py-1 text-left font-semibold hidden sm:table-cell">Instancia</th>
              <th class="px-2 py-1 text-right font-semibold">Local</th>
              <th class="px-2 py-1 text-center font-semibold">Resultado</th>
              <th class="px-2 py-1 text-left font-semibold">Visitante</th>
              <th class="px-2 py-1 text-left font-semibold">Informe</th>
            </tr>
          </thead>
          <tbody>
            {t.partidos.map((p: any) => (
              <tr class="border-b border-gray-200 last:border-0 hover:bg-gray-50">
                <td class="px-2 py-1.5 tabular-nums text-gray-600">{hora(p.fecha_utc)}</td>
                <td class="px-2 py-1.5 text-gray-600 hidden sm:table-cell">{nombreRonda(p.ronda)}</td>
                <td class="px-2 py-1.5">
                  <a href={urlEquipo(p.local)} class="flex items-center justify-end gap-1.5 text-[#2a6496] hover:underline">
                    <span class="truncate">{p.local.nombre}</span><Escudo equipo={p.local} size={16} />
                  </a>
                </td>
                <td class="px-2 py-1.5 text-center font-bold tabular-nums whitespace-nowrap">
                  {p.terminado ? `${p.goles_local}–${p.goles_visitante}` : <span class="font-normal text-gray-400">vs</span>}
                  {p.penales_local != null && <span class="block text-[10px] font-normal text-gray-500">({p.penales_local}–{p.penales_visitante} pen.)</span>}
                </td>
                <td class="px-2 py-1.5">
                  <a href={urlEquipo(p.visitante)} class="flex items-center gap-1.5 text-[#2a6496] hover:underline">
                    <Escudo equipo={p.visitante} size={16} /><span class="truncate">{p.visitante.nombre}</span>
                  </a>
                </td>
                <td class="px-2 py-1.5"><a href={urlPartido(p)} class="text-[#2a6496] hover:underline">{p.terminado ? "Ficha" : "Previa"}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  // Selector de fecha: va al día elegido
  for (const input of document.querySelectorAll<HTMLInputElement>('[data-fecha]')) {
    input.addEventListener('change', () => { if (input.value) window.location.href = `/partidos/fecha/${input.value}`; });
  }
</script>
