---
// Índice de jugadores (como "Football Players" de FBref): búsqueda, A-Z y destacados.
// Con ?q= muestra los resultados de la búsqueda.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LetrasAZ from "../../components/LetrasAZ.astro";
import TablaJugadores from "../../components/TablaJugadores.astro";
import { pedirApi } from "../../lib/api";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";

const data = (await pedirApi(`/api/jugadores${q ? `?q=${encodeURIComponent(q)}` : ""}`)) ?? {};
const letras = data.letras || [];
---

<BaseLayout title={`${q ? `Jugadores: "${q}"` : "Jugadores"} — ArgStats`}>
  <div class="font-sans text-sm text-gray-800 space-y-4">

    <section class="border border-gray-300 bg-white px-4 py-3 space-y-3">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Jugadores</h1>
        <p class="text-gray-600">
          {q ? "Buscá por nombre o recorré el índice por apellido." : `${data.total} jugadores del fútbol argentino con estadísticas, alineaciones y transferencias.`}
        </p>
      </div>

      <form action="/jugadores" method="get" class="flex max-w-lg">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Nombre del jugador"
          minlength="2"
          class="w-full border border-gray-400 px-3 py-1.5 focus:outline-none focus:border-[#0f5231]"
        />
        <button class="bg-[#0f5231] text-white px-5 py-1.5 font-bold hover:bg-[#0a3a22]">Buscar</button>
      </form>

      <div>
        <h2 class="text-xs font-bold text-gray-700 uppercase mb-1.5">Por apellido</h2>
        <LetrasAZ letras={letras} href={(l) => `/jugadores/letra/${l.toLowerCase()}`} />
      </div>
    </section>

    {q ? (
      <section class="border border-gray-300 bg-white overflow-x-auto">
        <h2 class="bg-[#0f5231] text-white font-bold px-3 py-1.5">
          Resultados para "{q}" ({data.total}{data.total > (data.jugadores?.length ?? 0) ? `, se muestran ${data.jugadores.length}` : ""})
        </h2>
        {data.jugadores?.length
          ? <TablaJugadores jugadores={data.jugadores} />
          : <p class="px-3 py-4 text-gray-500">No encontramos jugadores con ese nombre.</p>}
      </section>
    ) : (
      <section class="border border-gray-300 bg-white overflow-x-auto">
        <h2 class="bg-[#0f5231] text-white font-bold px-3 py-1.5">Jugadores con más partidos registrados</h2>
        <TablaJugadores jugadores={data.destacados || []} numerar />
      </section>
    )}
  </div>
</BaseLayout>
