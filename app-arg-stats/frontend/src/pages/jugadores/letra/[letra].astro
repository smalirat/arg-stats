---
// Jugadores cuyo apellido empieza con una letra: /jugadores/letra/{a-z} (como FBref)
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LetrasAZ from "../../../components/LetrasAZ.astro";
import TablaJugadores from "../../../components/TablaJugadores.astro";
import { pedirApi } from "../../../lib/api";

const letra = (Astro.params.letra ?? "").toLowerCase();
if (!/^[a-z]$/.test(letra)) return Astro.rewrite("/404");
if (Astro.params.letra !== letra) return Astro.redirect(`/jugadores/letra/${letra}`, 301);

const data = (await pedirApi(`/api/jugadores?letra=${letra}`)) ?? {};
const L = letra.toUpperCase();
---

<BaseLayout title={`Jugadores con ${L} — ArgStats`}>
  <div class="font-sans text-sm text-gray-800 space-y-4">

    <section class="border border-gray-300 bg-white px-4 py-3 space-y-3">
      <div>
        <p class="text-xs"><a href="/jugadores" class="text-[#2a6496] hover:underline">Jugadores</a> &rsaquo; {L}</p>
        <h1 class="text-2xl font-bold text-gray-900">Jugadores: apellidos con {L}</h1>
        <p class="text-gray-600">{data.total} jugadores, ordenados por apellido.</p>
      </div>
      <LetrasAZ letras={data.letras || []} actual={L} href={(l) => `/jugadores/letra/${l.toLowerCase()}`} />
    </section>

    <section class="border border-gray-300 bg-white overflow-x-auto">
      <h2 class="bg-[#0f5231] text-white font-bold px-3 py-1.5">{L}</h2>
      {data.jugadores?.length
        ? <TablaJugadores jugadores={data.jugadores} />
        : <p class="px-3 py-4 text-gray-500">No hay jugadores con esta letra.</p>}
    </section>
  </div>
</BaseLayout>
